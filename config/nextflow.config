/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/methylseq config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Configuration for running nf-core/methylseq on Flamingo with Slurm and Apptainer.
----------------------------------------------------------------------------------------
*/

apptainer {
    enabled = true
    autoMounts = true
    apptainer.cacheDir = "/mnt/beegfs01/scratch/a_houtman/nextflow/apptainer_cache"
    envWhitelist = "TMPDIR"
    runOptions = '-B $TMPDIR,/mnt/beegfs01/scratch/a_houtman/'
    pullTimeout = '3h'
}

env {
    NXF_HTTP_TIMEOUT = '3h'
    APPTAINER_CACHEDIR = '/mnt/beegfs01/scratch/a_houtman/nextflow/apptainer_cache'
}

executor {
  queueSize = 25
  submitRateLimit = '1/1s'
}

process {
  executor = 'slurm'
  errorStrategy = { 'retry' }
  maxRetries = 3
  pollInterval = '5s'
  queue = { task.time <= 6.h ? 'shortq' : task.time <= 24.h ? 'mediumq' : task.time <= 168.h ? 'longq' : 'verylongq' }

  resourceLimits = [
    memory: 128.GB,
    cpus: 32,
    time: 240.h
  ]

  // Use seven Bismark multicore alignment workers for faster per-sample alignment.
  withName: 'BISMARK_ALIGN' {
    cpus = 21
    memory = 96.GB
    time = 120.h
  }

  withName: 'BISMARK_DEDUPLICATE' {
    memory = 64.GB
  }

  withName: 'BISMARK_METHYLATIONEXTRACTOR' {
    cpus = 18
    memory = 36.GB
    time = 36.h
  }

  withName: 'TRIMGALORE' {
    memory = 12.GB
  }

  withName: 'SAMTOOLS_SORT' {
    memory = 18.GB
  }
}
